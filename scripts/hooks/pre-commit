#!/bin/sh
# Refuse a commit made under the wrong git identity.
#
# The identity that actually applies is not the one in .gitconfig whenever GIT_AUTHOR_EMAIL or
# GIT_COMMITTER_EMAIL are set: environment variables outrank every config file, including this
# repository's own. Tools that switch identity by exporting them leave the choice sitting in the
# shell for the rest of the session, where it follows you into unrelated repositories without
# saying so. A hook is the only place that sees what the commit is really about to carry.
#
# Install (not automatic — git will not run a hook from a tracked directory on its own):
#
#     git config core.hooksPath scripts/hooks

expected="tbbuck@users.noreply.github.com"

email_of() {
    git var "$1" | sed -n 's/.*<\(.*\)>.*/\1/p'
}

author=$(email_of GIT_AUTHOR_IDENT)
committer=$(email_of GIT_COMMITTER_IDENT)

if [ "$author" = "$expected" ] && [ "$committer" = "$expected" ]; then
    exit 0
fi

printf 'countercow: refusing to commit under the wrong identity.\n\n' >&2
printf '  expected   %s\n' "$expected" >&2
printf '  author     %s\n' "$author" >&2
printf '  committer  %s\n\n' "$committer" >&2
printf 'Environment variables beat every git config, so setting user.email may not fix it.\n' >&2
printf 'Inspect with:  git var GIT_AUTHOR_IDENT\n' >&2
printf 'Fix for one commit by exporting the right identity before committing:\n\n' >&2
printf '  export GIT_AUTHOR_EMAIL=%s GIT_COMMITTER_EMAIL=%s\n\n' "$expected" "$expected" >&2
exit 1
